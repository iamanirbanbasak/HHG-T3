# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Reverse image search (SerpAPI Google Lens) — https://serpapi.com
SERPAPI_KEY=

# Temporary public image hosting for the face crop — https://api.imgbb.com
IMGBB_KEY=

# Blockchain. NETWORK is "local" (in-process eth-tester) or "base-sepolia".
NETWORK=local
RPC_URL=
# Throwaway wallet holding only testnet faucet ETH. NEVER a wallet with mainnet value.
PRIVATE_KEY=
# Populated by `facechain deploy`
CONTRACT_ADDRESS=
