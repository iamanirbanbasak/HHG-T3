# Copy to .env and fill in. .env is git-ignored and must never be committed.

# Which search backend: "google_lens" (image matching) or "facecheck" (real face search).
# Google Lens finds copies of an image that are already indexed; it does NOT recognise a face and
# look for that person. For "scan a face, find their accounts", use facecheck.
SEARCH_PROVIDER=google_lens

# Reverse image search (SerpAPI Google Lens) — https://serpapi.com
SERPAPI_KEY=

# Face search engine — https://facecheck.id  (only needed when SEARCH_PROVIDER=facecheck)
FACECHECK_KEY=
# 1 = demo mode: reduced index, consumes no credits. Default on.
FACECHECK_DEMO=1

# Temporary public image hosting for the face crop — https://api.imgbb.com
IMGBB_KEY=

# Blockchain. NETWORK is "local" (in-process eth-tester) or "base-sepolia".
NETWORK=local
RPC_URL=
# Throwaway wallet holding only testnet faucet ETH. NEVER a wallet with mainnet value.
PRIVATE_KEY=
# Populated by `facechain deploy`
CONTRACT_ADDRESS=
